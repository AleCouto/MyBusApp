@page "/trains"
@inject IEnumerable<ITrainService> TrainServices
@inject FavoriteStore FavoriteStore
@inject MyBusApp.Utils.AppLogger Logger

<PageTitle>Comboios - MyBusApp</PageTitle>

<div class="container mt-4 d-flex flex-column align-items-center">
    <div class="row border-bottom pb-3 mb-4 w-100">
        <div class="col text-center">
            <h1 class="display-5"><span aria-hidden="true">🚆</span> Comboios</h1>
            <p class="text-muted">Consulte estações, destinos e próximas partidas.</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(favoriteMessage))
    {
        <div class="row w-100 justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
                <div class="alert alert-info" role="status">@favoriteMessage</div>
            </div>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(queryMessage))
    {
        <div class="row w-100 justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
                <div class="alert alert-warning" role="alert">@queryMessage</div>
            </div>
        </div>
    }

    <div class="row w-100 justify-content-center">
        <div class="col-12 col-md-8 col-lg-6 mb-4">
            <div class="card shadow-sm border-0 bg-light p-3">
                <div class="mb-3">
                    <label class="form-label fw-bold text-secondary small text-uppercase">1. Selecione o operador</label>
                    <select class="form-select form-select-lg" @onchange="OnTrainOperatorSelectedAsync">
                        <option value="">-- Escolha o operador --</option>
                        @foreach (var trainService in TrainServices)
                        {
                            <option value="@trainService.OperatorName">@trainService.OperatorName</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold text-secondary small text-uppercase">2. Selecione a estação</label>
                    <select class="form-select"
                            @onchange="OnTrainStationSelectedAsync"
                            disabled="@(isLoadingTrainStations || selectedTrainService is null)">
                        <option value="">-- @(isLoadingTrainStations ? "A carregar estações..." : "Escolha a estação") --</option>
                        @foreach (var station in trainStations)
                        {
                            <option value="@station.Id">@station.Name</option>
                        }
                    </select>
                </div>
                @if (selectedTrainStation is not null && IsCpSelected)
                {
                    <div class="d-flex justify-content-between align-items-center mt-n2 mb-3">
                        <span class="small text-muted">@selectedTrainStation.Name</span>
                        <MyBusApp.Components.FavoriteStar ItemName="@selectedTrainStation.Name"
                                                          IsFavorite="@isTrainFavorite"
                                                          Disabled="@(!isTrainFavoriteStateLoaded || isUpdatingTrainFavorite)"
                                                          OnClick="ToggleTrainFavoriteAsync" />
                    </div>
                }
                <div>
                    <label class="form-label fw-bold text-secondary small text-uppercase">3. Selecione o destino</label>
                    <select class="form-select"
                            @onchange="OnTrainDirectionSelectedAsync"
                            disabled="@(isLoadingTrainDirections || selectedTrainStation is null)">
                        <option value="">-- @(isLoadingTrainDirections ? "A carregar destinos..." : "Escolha o destino") --</option>
                        @foreach (var direction in trainDirections)
                        {
                            <option value="@direction.Id">@direction.Name</option>
                        }
                    </select>
                </div>
            </div>

            @if (selectedTrainService is not null && !isLoadingTrainStations && trainStations.Count == 0)
            {
                <div class="alert alert-warning mt-3" role="alert">Não existem estações disponíveis para este operador.</div>
            }
            else if (selectedTrainStation is not null && !isLoadingTrainDirections && trainDirections.Count == 0)
            {
                <div class="alert alert-warning mt-3" role="alert">Não existem destinos disponíveis para esta estação.</div>
            }

            @if (isLoadingTrainDepartures)
            {
                <div class="text-center p-5" role="status">
                    <div class="spinner-border text-primary"></div>
                    <p class="mt-3 text-muted">A consultar próximas partidas...</p>
                </div>
            }
            else if (selectedTrainDirection is not null)
            {
                <div class="card shadow-sm border-0 mt-3">
                    <div class="card-body bg-primary text-white rounded-top">
                        <h4 class="mb-0">@selectedTrainStation?.Name</h4>
                        <small class="opacity-75">Próximas partidas para @selectedTrainDirection.Name</small>
                    </div>
                    <ul class="list-group list-group-flush">
                        @if (trainDepartures.Count > 0)
                        {
                            @foreach (var departure in trainDepartures)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                                    <div>
                                        <span class="badge bg-primary fs-6 px-3">@departure.ServiceName</span>
                                        <span class="ms-2 text-dark small">@departure.Destination</span>
                                    </div>
                                    <h5 class="mb-0 fw-bold">@departure.DisplayTime</h5>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="list-group-item p-5 text-center text-muted">
                                Sem próximas partidas para esta combinação.
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private ITrainService? selectedTrainService;
    private List<TrainStation> trainStations = [];
    private List<TrainDirection> trainDirections = [];
    private List<TrainDeparture> trainDepartures = [];
    private TrainStation? selectedTrainStation;
    private TrainDirection? selectedTrainDirection;
    private bool isLoadingTrainStations;
    private bool isLoadingTrainDirections;
    private bool isLoadingTrainDepartures;
    private bool isTrainFavorite;
    private bool isTrainFavoriteStateLoaded;
    private bool isUpdatingTrainFavorite;
    private string? favoriteMessage;
    private string? queryMessage;

    private bool IsCpSelected
        => string.Equals(selectedTrainService?.OperatorName, "CP", StringComparison.Ordinal);

    private TransitFavorite? GetSelectedTrainFavorite()
    {
        if (!IsCpSelected || selectedTrainStation is null)
            return null;

        return new TransitFavorite(
            FavoriteTransportMode.Train,
            FavoriteProvider.Cp,
            selectedTrainStation.Id,
            selectedTrainStation.Name);
    }

    private async Task LoadTrainFavoriteStateAsync()
    {
        try
        {
            var favorite = GetSelectedTrainFavorite();
            if (favorite is null)
                return;

            isTrainFavorite = await FavoriteStore.IsFavoriteAsync(favorite);
            isTrainFavoriteStateLoaded = true;
        }
        catch (Exception exception) when (exception is JSException or System.Text.Json.JsonException or InvalidDataException)
        {
            Logger.Error(nameof(Trains), "Failed to read the train favorite state.", exception);
            favoriteMessage = "Não foi possível consultar os favoritos neste browser.";
        }
    }

    private async Task ToggleTrainFavoriteAsync()
    {
        var favorite = GetSelectedTrainFavorite();
        if (favorite is null || !isTrainFavoriteStateLoaded || isUpdatingTrainFavorite)
            return;

        var previousState = isTrainFavorite;
        var requestedState = !previousState;
        isTrainFavorite = requestedState;
        isUpdatingTrainFavorite = true;
        favoriteMessage = null;
        try
        {
            isTrainFavorite = await FavoriteStore.SetFavoriteAsync(favorite, requestedState);
            favoriteMessage = isTrainFavorite
                ? "Favorito guardado."
                : "Favorito removido.";
        }
        catch (Exception exception) when (exception is JSException or System.Text.Json.JsonException or InvalidDataException or ArgumentException)
        {
            isTrainFavorite = previousState;
            Logger.Error(nameof(Trains), "Failed to update the train favorite.", exception);
            favoriteMessage = "Não foi possível atualizar o favorito neste browser.";
        }
        finally
        {
            isUpdatingTrainFavorite = false;
        }
    }

    private async Task OnTrainOperatorSelectedAsync(ChangeEventArgs args)
    {
        ResetTrainSearch();
        favoriteMessage = null;
        queryMessage = null;
        selectedTrainService = TrainServices.FirstOrDefault(service =>
            string.Equals(service.OperatorName, args.Value?.ToString(), StringComparison.Ordinal));
        if (selectedTrainService is null) return;
        isLoadingTrainStations = true;
        try
        {
            trainStations = await selectedTrainService.GetStationsAsync();
        }
        catch (TransitSourceUnavailableException exception)
        {
            Logger.Warning(nameof(Trains), $"Train source unavailable: {exception.Message}");
            queryMessage = "O serviço ferroviário está temporariamente indisponível.";
        }
        catch (Exception exception)
        {
            Logger.Error(nameof(Trains), "Failed to load train stations.", exception);
            queryMessage = "Ocorreu um erro ao carregar as estações.";
        }
        finally
        {
            isLoadingTrainStations = false;
        }
    }

    private async Task OnTrainStationSelectedAsync(ChangeEventArgs args)
    {
        selectedTrainStation = trainStations.FirstOrDefault(station => station.Id == args.Value?.ToString());
        selectedTrainDirection = null;
        trainDirections.Clear();
        trainDepartures.Clear();
        isTrainFavoriteStateLoaded = false;
        isTrainFavorite = false;
        if (selectedTrainStation is null || selectedTrainService is null) return;
        favoriteMessage = null;
        isLoadingTrainDirections = true;
        queryMessage = null;
        try
        {
            await LoadTrainFavoriteStateAsync();
            trainDirections = await selectedTrainService.GetDestinationsAsync(selectedTrainStation.Id);
        }
        catch (TransitSourceUnavailableException exception)
        {
            Logger.Warning(nameof(Trains), $"Train source unavailable: {exception.Message}");
            queryMessage = "O serviço ferroviário está temporariamente indisponível.";
        }
        catch (Exception exception)
        {
            Logger.Error(nameof(Trains), "Failed to load train destinations.", exception);
            queryMessage = "Ocorreu um erro ao carregar os destinos.";
        }
        finally
        {
            isLoadingTrainDirections = false;
        }
    }

    private async Task OnTrainDirectionSelectedAsync(ChangeEventArgs args)
    {
        selectedTrainDirection = trainDirections.FirstOrDefault(direction => direction.Id == args.Value?.ToString());
        trainDepartures.Clear();
        if (selectedTrainDirection is null || selectedTrainStation is null || selectedTrainService is null) return;
        isLoadingTrainDepartures = true;
        queryMessage = null;
        try
        {
            trainDepartures = await selectedTrainService.GetDeparturesAsync(selectedTrainStation.Id, selectedTrainDirection.Id);
        }
        catch (TransitSourceUnavailableException exception)
        {
            Logger.Warning(nameof(Trains), $"Train source unavailable: {exception.Message}");
            queryMessage = "O serviço ferroviário está temporariamente indisponível.";
        }
        catch (Exception exception)
        {
            Logger.Error(nameof(Trains), "Failed to load train departures.", exception);
            queryMessage = "Ocorreu um erro ao consultar as próximas partidas.";
        }
        finally
        {
            isLoadingTrainDepartures = false;
        }
    }

    private void ResetTrainSearch()
    {
        queryMessage = null;
        selectedTrainService = null;
        selectedTrainStation = null;
        selectedTrainDirection = null;
        isTrainFavorite = false;
        isTrainFavoriteStateLoaded = false;
        isUpdatingTrainFavorite = false;
        trainStations.Clear();
        trainDirections.Clear();
        trainDepartures.Clear();
        isLoadingTrainStations = false;
        isLoadingTrainDirections = false;
        isLoadingTrainDepartures = false;
    }
}
