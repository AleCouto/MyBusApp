@page "/buses"
@inject BusServiceRouter BusServiceRouter
@inject FavoriteStore FavoriteStore
@inject MyBusApp.Utils.AppLogger Logger
@inject NavigationManager NavigationManager

<PageTitle>Autocarros - MyBusApp</PageTitle>

<div class="container mt-4 d-flex flex-column align-items-center">
    <div class="row border-bottom pb-3 mb-4 w-100">
        <div class="col text-center">
            <h1 class="display-5"><span aria-hidden="true">🚌</span> Autocarros</h1>
            <p class="text-muted">Consulte linhas, paragens e próximas partidas.</p>
        </div>
    </div>

    <div class="row w-100 justify-content-center">
        <div class="col-12 col-md-8 col-lg-6 mb-4">
            <div class="input-group shadow-sm">
                <span class="input-group-text bg-white" aria-hidden="true">🔍</span>
                <input class="form-control"
                       placeholder="Digite o número da linha (ex: 1612)"
                       @bind="lineNumber"
                       @onkeyup="@(args => args.Key == "Enter" ? SearchBusAsync() : Task.CompletedTask)" />
                <button class="btn btn-primary px-4" @onclick="SearchBusAsync" disabled="@isLoadingBus">
                    @if (isLoadingBus)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-label="A pesquisar"></span>
                    }
                    else
                    {
                        <span>Pesquisar</span>
                    }
                </button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(favoriteMessage))
    {
        <div class="row w-100 justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
                <div class="alert alert-info" role="status">@favoriteMessage</div>
            </div>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(queryMessage))
    {
        <div class="row w-100 justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
                <div class="alert alert-warning" role="alert">@queryMessage</div>
            </div>
        </div>
    }

    <div class="row w-100 justify-content-center">
        <div class="col-12 col-md-8 col-lg-6 mb-4">
            @if (hasSearchedBus)
            {
                if (currentLine is not null)
                {
                    <div class="card shadow-sm p-3 border-0 bg-light">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-secondary small text-uppercase">1. Selecione o destino</label>
                            <select class="form-select form-select-lg shadow-sm"
                                    value="@selectedBusDirection?.Id"
                                    @onchange="OnBusDirectionSelectedAsync">
                                <option value="">-- Escolha o destino --</option>
                                @foreach (var direction in busDirections)
                                {
                                    <option value="@direction.Id">@direction.Name</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="form-label fw-bold text-secondary small text-uppercase">2. Selecione a paragem</label>
                            <select class="form-select shadow-sm"
                                    value="@selectedBusStop?.Id"
                                    @onchange="OnBusStopSelectedAsync"
                                    disabled="@(isFilteringBusStops || !busStops.Any())">
                                @if (isFilteringBusStops)
                                {
                                    <option>A filtrar percurso...</option>
                                }
                                else
                                {
                                    <option value="">-- @(busStops.Any() ? "Escolha a paragem" : "Selecione o sentido primeiro") --</option>
                                    @foreach (var stop in busStops)
                                    {
                                        <option value="@stop.Id">@stop.Name</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                }
                else if (!isLoadingBus)
                {
                    <div class="alert alert-warning border-0 shadow-sm" role="alert">
                        Linha <strong>@lineNumber</strong> não encontrada.
                    </div>
                }
            }

            @if (isLoadingBusArrivals)
            {
                <div class="text-center p-5" role="status">
                    <div class="spinner-border text-primary"></div>
                    <p class="mt-3 text-muted">A consultar horários em tempo real...</p>
                </div>
            }
            else if (selectedBusStop is not null)
            {
                <div class="card shadow-sm border-0 mt-3">
                    <div class="card-body bg-primary text-white rounded-top d-flex justify-content-between align-items-center">
                        <div>
                            <h4 class="mb-0">@selectedBusStop.Name</h4>
                            <small class="opacity-75">Próximas partidas</small>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <MyBusApp.Components.FavoriteStar ItemName="@selectedBusStop.Name"
                                                              IsFavorite="@isBusFavorite"
                                                              Disabled="@(!isBusFavoriteStateLoaded || isUpdatingBusFavorite)"
                                                              OnClick="ToggleBusFavoriteAsync" />
                            <button class="refresh-arrivals-button"
                                    @onclick="RefreshBusArrivalsAsync"
                                    aria-label="Atualizar chegadas"
                                    title="Atualizar chegadas">
                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                    <path d="M5 8a7 7 0 0 1 12-3l3 2-3 3M19 16a7 7 0 0 1-12 3l-3-2 3-3" />
                                </svg>
                            </button>
                        </div>
                    </div>
                    <ul class="list-group list-group-flush">
                        @if (busArrivals.Count > 0)
                        {
                            @foreach (var arrival in busArrivals)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                                    <div>
                                        <span class="badge bg-primary fs-6 px-3">@arrival.LineNumber</span>
                                        <span class="ms-2 text-dark small">@arrival.Destination</span>
                                    </div>
                                    <div class="text-end">
                                        <h5 class="mb-0 fw-bold @(arrival.IsRealTime ? "text-success" : "text-dark")">
                                            @if (arrival.IsRealTime)
                                            {
                                                <span class="me-1" aria-hidden="true">🟢</span>
                                            }
                                            @arrival.DisplayTime
                                        </h5>
                                        <small class="text-muted">@(arrival.IsRealTime ? "Tempo Real" : "Agendado")</small>
                                    </div>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="list-group-item p-5 text-center text-muted">
                                Sem previsões de chegada para esta linha agora.
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string lineNumber = string.Empty;
    private BusLine? currentLine;
    private IBusService? activeBusService;
    private List<BusDirection> busDirections = [];
    private List<BusStop> busStops = [];
    private List<BusArrival> busArrivals = [];
    private BusDirection? selectedBusDirection;
    private BusStop? selectedBusStop;
    private bool isLoadingBus;
    private bool isFilteringBusStops;
    private bool isLoadingBusArrivals;
    private bool hasSearchedBus;
    private bool isBusFavorite;
    private bool isBusFavoriteStateLoaded;
    private bool isUpdatingBusFavorite;
    private string? favoriteMessage;
    private string? queryMessage;
    private string? loadedFavoriteRoute;

    protected override async Task OnParametersSetAsync()
    {
        var query = NavigationManager.ToAbsoluteUri(NavigationManager.Uri).Query;
        var providerQuery = GetQueryValue(query, "provider");
        var lineQuery = GetQueryValue(query, "line");
        var stopQuery = GetQueryValue(query, "stop");
        var directionQuery = GetQueryValue(query, "direction");
        if (string.IsNullOrWhiteSpace(providerQuery) ||
            string.IsNullOrWhiteSpace(lineQuery) ||
            string.IsNullOrWhiteSpace(stopQuery))
            return;

        var routeKey = $"{providerQuery}|{lineQuery}|{stopQuery}|{directionQuery}";
        if (string.Equals(routeKey, loadedFavoriteRoute, StringComparison.Ordinal))
            return;
        loadedFavoriteRoute = routeKey;

        if (!Enum.TryParse<BusProvider>(providerQuery, true, out var provider) ||
            !Enum.IsDefined(provider))
        {
            queryMessage = "O fornecedor do favorito não é válido.";
            return;
        }

        lineNumber = lineQuery;
        await SearchBusAsync(provider, stopQuery, directionQuery);
    }

    private static string? GetQueryValue(string query, string name)
    {
        foreach (var parameter in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var separator = parameter.IndexOf('=');
            var key = separator < 0 ? parameter : parameter[..separator];
            if (!string.Equals(System.Net.WebUtility.UrlDecode(key), name, StringComparison.Ordinal))
                continue;

            var value = separator < 0 ? string.Empty : parameter[(separator + 1)..];
            return System.Net.WebUtility.UrlDecode(value);
        }

        return null;
    }

    private Task SearchBusAsync() => SearchBusAsync(null, null);

    private async Task SearchBusAsync(BusProvider? provider, string? stopId, string? directionId = null)
    {
        if (string.IsNullOrWhiteSpace(lineNumber)) return;
        favoriteMessage = null;
        queryMessage = null;
        isLoadingBus = true;
        ResetBusSearch();
        hasSearchedBus = true;
        try
        {
            var resolved = provider is null
                ? await BusServiceRouter.ResolveLineAsync(lineNumber)
                : await BusServiceRouter.ResolveLineAsync(provider.Value, lineNumber);
            currentLine = resolved.Line;
            activeBusService = resolved.Service;
            if (currentLine is not null && activeBusService is not null)
            {
                busDirections = await activeBusService.GetDirectionsAsync(currentLine.Id);
                if (stopId is not null)
                    await SelectBusFavoriteStopAsync(stopId, directionId);
            }
        }
        catch (TransitSourceUnavailableException exception)
        {
            Logger.Warning(nameof(Buses), $"Bus source unavailable: {exception.Message}");
            queryMessage = "O serviço de autocarros está temporariamente indisponível.";
        }
        catch (Exception exception)
        {
            Logger.Error(nameof(Buses), "Failed to search for a bus line.", exception);
            queryMessage = "Ocorreu um erro ao pesquisar esta linha.";
        }
        finally
        {
            isLoadingBus = false;
        }
    }

    private async Task SelectBusFavoriteStopAsync(string stopId, string? directionId = null)
    {
        if (currentLine is null || activeBusService is null)
            return;

        if (!string.IsNullOrWhiteSpace(directionId))
        {
            var requestedDirection = busDirections.FirstOrDefault(direction =>
                string.Equals(direction.Id, directionId, StringComparison.Ordinal));
            if (requestedDirection is not null)
            {
                var requestedStops = await activeBusService.GetStopsAsync(requestedDirection.Id, currentLine.Id);
                var requestedStop = requestedStops.FirstOrDefault(candidate =>
                    string.Equals(candidate.Id, stopId, StringComparison.Ordinal));
                if (requestedStop is not null)
                {
                    selectedBusDirection = requestedDirection;
                    busStops = requestedStops;
                    selectedBusStop = requestedStop;
                    await LoadBusFavoriteStateAsync();
                    await RefreshBusArrivalsAsync();
                    return;
                }
            }
        }

        foreach (var direction in busDirections)
        {
            var stops = await activeBusService.GetStopsAsync(direction.Id, currentLine.Id);
            var stop = stops.FirstOrDefault(candidate =>
                string.Equals(candidate.Id, stopId, StringComparison.Ordinal));
            if (stop is null)
                continue;

            selectedBusDirection = direction;
            busStops = stops;
            selectedBusStop = stop;
            await LoadBusFavoriteStateAsync();
            await RefreshBusArrivalsAsync();
            return;
        }

        queryMessage = "A paragem guardada já não está disponível nesta linha.";
    }

    private async Task OnBusDirectionSelectedAsync(ChangeEventArgs args)
    {
        selectedBusStop = null;
        selectedBusDirection = busDirections.FirstOrDefault(direction =>
            direction.Id == args.Value?.ToString());
        busArrivals.Clear();
        busStops.Clear();
        var directionId = args.Value?.ToString();
        if (string.IsNullOrEmpty(directionId) || currentLine is null || activeBusService is null) return;
        isFilteringBusStops = true;
        queryMessage = null;
        try
        {
            busStops = await activeBusService.GetStopsAsync(directionId, currentLine.Id);
        }
        catch (TransitSourceUnavailableException exception)
        {
            Logger.Warning(nameof(Buses), $"Bus source unavailable: {exception.Message}");
            queryMessage = "O serviço de autocarros está temporariamente indisponível.";
        }
        catch (Exception exception)
        {
            Logger.Error(nameof(Buses), "Failed to load bus stops.", exception);
            queryMessage = "Ocorreu um erro ao carregar as paragens.";
        }
        finally
        {
            isFilteringBusStops = false;
        }
    }

    private async Task OnBusStopSelectedAsync(ChangeEventArgs args)
    {
        selectedBusStop = busStops.FirstOrDefault(stop => stop.Id == args.Value?.ToString());
        isBusFavoriteStateLoaded = false;
        favoriteMessage = null;
        if (selectedBusStop is null)
            return;

        await LoadBusFavoriteStateAsync();
        await RefreshBusArrivalsAsync();
    }

    private async Task RefreshBusArrivalsAsync()
    {
        if (selectedBusStop is null || currentLine is null || activeBusService is null) return;
        isLoadingBusArrivals = true;
        queryMessage = null;
        try
        {
            busArrivals = await activeBusService.GetArrivalsAsync(
                selectedBusStop.Id,
                currentLine.Id,
                selectedBusDirection?.Id);
        }
        catch (TransitSourceUnavailableException exception)
        {
            Logger.Warning(nameof(Buses), $"Bus source unavailable: {exception.Message}");
            queryMessage = "O serviço de autocarros está temporariamente indisponível.";
        }
        catch (Exception exception)
        {
            Logger.Error(nameof(Buses), "Failed to load bus arrivals.", exception);
            queryMessage = "Ocorreu um erro ao consultar as próximas passagens.";
        }
        finally
        {
            isLoadingBusArrivals = false;
        }
    }

    private TransitFavorite? GetSelectedBusFavorite()
    {
        if (currentLine is null || selectedBusStop is null)
            return null;

        var provider = currentLine.Provider switch
        {
            BusProvider.Metropolitana => FavoriteProvider.Metropolitana,
            BusProvider.CarrisLisboa => FavoriteProvider.CarrisLisboa,
            BusProvider.Transitland => FavoriteProvider.Transitland,
            _ => (FavoriteProvider?)null
        };
        if (provider is null)
            return null;

        return new TransitFavorite(
            FavoriteTransportMode.Bus,
            provider.Value,
            selectedBusStop.Id,
            selectedBusStop.Name,
            currentLine.ShortName,
            DirectionId: selectedBusDirection?.Id);
    }

    private async Task LoadBusFavoriteStateAsync()
    {
        try
        {
            var favorite = GetSelectedBusFavorite();
            if (favorite is null)
                return;

            isBusFavorite = await FavoriteStore.IsFavoriteAsync(favorite);
            isBusFavoriteStateLoaded = true;
        }
        catch (Exception exception) when (exception is JSException or System.Text.Json.JsonException or InvalidDataException)
        {
            Logger.Error(nameof(Buses), "Failed to read the bus favorite state.", exception);
            favoriteMessage = "Não foi possível consultar os favoritos neste browser.";
        }
    }

    private async Task ToggleBusFavoriteAsync()
    {
        var favorite = GetSelectedBusFavorite();
        if (favorite is null || !isBusFavoriteStateLoaded || isUpdatingBusFavorite)
            return;

        var previousState = isBusFavorite;
        var requestedState = !previousState;
        isBusFavorite = requestedState;
        isUpdatingBusFavorite = true;
        favoriteMessage = null;
        try
        {
            isBusFavorite = await FavoriteStore.SetFavoriteAsync(favorite, requestedState);
            favoriteMessage = isBusFavorite
                ? "Favorito guardado."
                : "Favorito removido.";
        }
        catch (Exception exception) when (exception is JSException or System.Text.Json.JsonException or InvalidDataException or ArgumentException)
        {
            isBusFavorite = previousState;
            Logger.Error(nameof(Buses), "Failed to update the bus favorite.", exception);
            favoriteMessage = "Não foi possível atualizar o favorito neste browser.";
        }
        finally
        {
            isUpdatingBusFavorite = false;
        }
    }

    private void ResetBusSearch()
    {
        queryMessage = null;
        currentLine = null;
        activeBusService = null;
        selectedBusDirection = null;
        selectedBusStop = null;
        isBusFavorite = false;
        isBusFavoriteStateLoaded = false;
        isUpdatingBusFavorite = false;
        busDirections.Clear();
        busStops.Clear();
        busArrivals.Clear();
        isFilteringBusStops = false;
        isLoadingBusArrivals = false;
        hasSearchedBus = false;
    }
}
