@using System.Text.Json
@using Microsoft.JSInterop
@using MyBusApp.Utils
@implements IAsyncDisposable
@inject FavoriteStore FavoriteStore
@inject BusServiceRouter BusServiceRouter
@inject IEnumerable<ITrainService> TrainServices
@inject AppLogger Logger
@inject IJSRuntime JS
@inject IConfiguration Configuration
@inject TimeProvider TimeProvider

<section class="row w-100 justify-content-center mb-4" aria-labelledby="favorites-heading">
    <div class="col-12 col-lg-10">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 id="favorites-heading" class="h4 mb-0">Próximas partidas</h2>
            <button class="btn btn-outline-primary btn-sm" @onclick="RefreshAsync" disabled="@(!hasLoadedFavorites || isLoading)">
                <i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>Atualizar
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(storageError))
        {
            <div class="alert alert-warning" role="alert">
                @storageError
                @if (!hasLoadedFavorites && !isLoading)
                {
                    <div class="mt-2">
                        <button class="btn btn-outline-warning btn-sm"
                                aria-label="Tentar novamente carregar favoritos"
                                @onclick="RetryLoadFavoritesAsync">
                            Tentar novamente
                        </button>
                    </div>
                }
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="alert alert-info" role="status">@statusMessage</div>
        }

        @if (!hasLoadedFavorites && isLoading)
        {
            <div class="text-center p-4" role="status">
                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                A carregar favoritos...
            </div>
        }
        else if (hasLoadedFavorites && entries.Count == 0)
        {
            <div class="alert alert-light border text-muted" role="status">
                Ainda não guardou favoritos. Pesquise uma linha ou estação e guarde a paragem ou estação que utiliza.
            </div>
        }
        else if (hasLoadedFavorites)
        {
            <div class="d-flex flex-column gap-3">
                @for (var index = 0; index < entries.Count; index++)
                {
                    var entry = entries[index];
                    <article @key="entry.Favorite" class="card shadow-sm">
                        <div class="card-header d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-2">
                            <div class="flex-grow-1">
                                <small class="text-muted d-block mb-1">@GetProviderName(entry.Favorite.Provider) · @GetModeName(entry.Favorite.Mode)</small>
                                @if (entry.Favorite.Mode == FavoriteTransportMode.Bus)
                                {
                                    <div class="d-flex flex-column flex-sm-row gap-2 gap-sm-4">
                                        <div>
                                            <small class="text-muted">Linha</small>
                                            <div class="fw-semibold">@(string.IsNullOrWhiteSpace(entry.Favorite.LineNumber) ? "Indisponível" : entry.Favorite.LineNumber)</div>
                                        </div>
                                        <div>
                                            <small class="text-muted">Paragem</small>
                                            <div class="fw-semibold text-break">@(string.IsNullOrWhiteSpace(entry.Favorite.StopName) ? "Indisponível" : entry.Favorite.StopName)</div>
                                        </div>
                                    </div>
                                }
                                else if (entry.Favorite.Mode == FavoriteTransportMode.Train)
                                {
                                    <h3 class="h6 mb-1">@entry.Favorite.StopName</h3>
                                    <small class="text-muted">
                                        Estação ·
                                        @(entry.Favorite.DestinationId is null
                                            ? "Destino por selecionar (favorito antigo)"
                                            : $"Destino: {entry.DestinationName ?? "Indisponível"}")
                                    </small>
                                }
                                else
                                {
                                    <h3 class="h6 mb-1">@GetFavoriteTitle(entry)</h3>
                                }
                            </div>
                            <div class="d-flex flex-wrap gap-1 flex-shrink-0 align-self-end align-self-lg-center">
                                <a class="btn btn-outline-primary btn-sm"
                                   href="@GetFavoriteUrl(entry)"
                                   aria-label="Ver mais partidas para @GetFavoriteTitle(entry)">
                                    Ver mais partidas
                                </a>
                                <button class="btn btn-outline-secondary btn-sm"
                                        title="Mover favorito para cima"
                                        aria-label="Mover @GetFavoriteTitle(entry) para cima"
                                        disabled="@(index == 0 || isLoading)"
                                        @onclick="() => MoveAsync(entry.Favorite, -1)">
                                    <svg class="d-block" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                                        <path d="M4 12l1.41 1.41L11 7.83V20h2V7.83l5.58 5.59L20 12l-8-8-8 8z" />
                                    </svg>
                                </button>
                                <button class="btn btn-outline-secondary btn-sm"
                                        title="Mover favorito para baixo"
                                        aria-label="Mover @GetFavoriteTitle(entry) para baixo"
                                        disabled="@(index == entries.Count - 1 || isLoading)"
                                        @onclick="() => MoveAsync(entry.Favorite, 1)">
                                    <svg class="d-block" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                                        <path d="M20 12l-1.41-1.41L13 16.17V4h-2v12.17l-5.58-5.59L4 12l8 8 8-8z" />
                                    </svg>
                                </button>
                                <button class="btn btn-outline-danger btn-sm"
                                        title="Remover favorito"
                                        aria-label="Remover @GetFavoriteTitle(entry)"
                                        disabled="@isLoading"
                                        @onclick="() => RemoveAsync(entry.Favorite)">
                                    <svg class="d-block text-danger" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                                        <path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" />
                                    </svg>
                                </button>
                            </div>
                        </div>
                        @if (entry.State == FavoriteQueryState.Loading && entry.LastSuccessfulState is null)
                        {
                            <div class="card-body text-muted" role="status">
                                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                                A carregar próximas partidas...
                            </div>
                        }
                        else
                        {
                            @if (entry.State == FavoriteQueryState.LegacyNeedsDirection)
                            {
                                <div class="card-body text-warning">
                                    Este favorito antigo não guarda o sentido da linha. Selecione o sentido e volte a guardar o favorito.
                                    <div><a href="@GetFavoriteUrl(entry)">Selecionar sentido e paragem</a></div>
                                </div>
                            }
                            else if (entry.State == FavoriteQueryState.LegacyNeedsDestination)
                            {
                                <div class="card-body text-warning">
                                    Este favorito antigo não guarda um destino. Selecione a estação e o destino para criar um favorito específico.
                                    <div><a href="/trains">Selecionar estação e destino</a></div>
                                </div>
                            }
                            else if (entry.State == FavoriteQueryState.DestinationUnavailable)
                            {
                                <div class="card-body text-warning" role="alert">
                                    O destino guardado já não está disponível na fonte. Selecione novamente a estação e o destino.
                                    <div><a href="/trains">Selecionar estação e destino</a></div>
                                </div>
                            }
                            else if (entry.State == FavoriteQueryState.Loading)
                            {
                                <div class="card-body text-muted" role="status">
                                    <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                                    A atualizar; a manter os últimos resultados válidos.
                                </div>
                            }
                            else if (entry.State == FavoriteQueryState.Unavailable)
                            {
                                <div class="card-body text-warning" role="alert">
                                    O serviço ou a fonte está indisponível.
                                    @if (entry.LastSuccessfulState == FavoriteQueryState.WithDepartures)
                                    {
                                        <span> A apresentar as partidas da última consulta válida.</span>
                                    }
                                    else if (entry.LastSuccessfulState == FavoriteQueryState.NoDepartures)
                                    {
                                        <span> A última consulta válida não tinha partidas.</span>
                                    }
                                </div>
                            }
                            else if (entry.State == FavoriteQueryState.Error)
                            {
                                <div class="card-body text-warning" role="alert">
                                    Ocorreu um erro ao consultar este favorito.
                                    @if (entry.LastSuccessfulState == FavoriteQueryState.WithDepartures)
                                    {
                                        <span> A apresentar as partidas da última consulta válida.</span>
                                    }
                                    else if (entry.LastSuccessfulState == FavoriteQueryState.NoDepartures)
                                    {
                                        <span> A última consulta válida não tinha partidas.</span>
                                    }
                                </div>
                            }

                            @if (entry.Favorite.Mode == FavoriteTransportMode.Bus && entry.BusArrivals.Count > 0)
                            {
                                <ul class="list-group list-group-flush">
                                    @foreach (var group in entry.BusArrivals
                                        .GroupBy(GetBusDestinationLabel)
                                        .OrderBy(group => group.Min(arrival => GetMinutesUntil(arrival.DisplayTime))))
                                    {
                                        <li class="list-group-item">
                                            <div class="row g-2 align-items-start">
                                                <div class="col-12 col-md-3">
                                                    <small class="text-muted">Destino</small>
                                                    <div class="fw-semibold text-break">@group.Key</div>
                                                </div>
                                                <div class="col-12 col-md-9">
                                                    <div class="row row-cols-2 row-cols-md-3 row-cols-xl-5 g-2 justify-content-md-end">
                                                        @foreach (var arrival in group)
                                                        {
                                                            <div class="col">
                                                                <div class="text-start text-md-end">
                                                                    <strong class="@(arrival.IsRealTime ? "text-success" : "text-dark")">
                                                                        @if (arrival.IsRealTime)
                                                                        {
                                                                            <i class="bi bi-broadcast me-1" aria-hidden="true"></i>
                                                                        }
                                                                        @arrival.DisplayTime
                                                                    </strong>
                                                                    <div><small class="text-muted">@(arrival.IsRealTime ? "Tempo real" : "Agendado")</small></div>
                                                                    <div><small class="text-muted">@GetRemainingLabel(arrival.DisplayTime)</small></div>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            }
                            else if (entry.Favorite.Mode == FavoriteTransportMode.Train && entry.TrainDepartures.Count > 0)
                            {
                                <ul class="list-group list-group-flush">
                                    @foreach (var group in entry.TrainDepartures
                                        .GroupBy(departure => (departure.ServiceName, departure.Destination))
                                        .OrderBy(group => group.Min(departure => GetMinutesUntil(departure.DisplayTime))))
                                    {
                                        <li class="list-group-item">
                                            <div class="row g-2 align-items-start">
                                                <div class="col-12 col-md-3">
                                                    <span class="badge bg-primary">@group.Key.ServiceName</span>
                                                    <div class="fw-semibold text-break">@group.Key.Destination</div>
                                                </div>
                                                <div class="col-12 col-md-9">
                                                    <div class="row row-cols-2 row-cols-md-3 row-cols-xl-5 g-2 justify-content-md-end">
                                                        @foreach (var departure in group)
                                                        {
                                                            <div class="col">
                                                                <div class="text-start text-md-end">
                                                                    <strong>@departure.DisplayTime</strong>
                                                                    <div><small class="text-muted">Agendado</small></div>
                                                                    <div><small class="text-muted">@GetRemainingLabel(departure.DisplayTime)</small></div>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            }
                            else if (entry.LastSuccessfulState == FavoriteQueryState.NoDepartures)
                            {
                                <div class="card-body text-muted">
                                    Consulta concluída sem partidas disponíveis.
                                </div>
                            }
                        }
                    </article>
                }
            </div>
        }
    </div>
</section>

@code {
    private List<TransitFavorite> favorites = [];
    private List<FavoriteEntry> entries = [];
    private bool isLoading = true;
    private bool hasLoadedFavorites;
    private string? storageError;
    private string? statusMessage;
    private TimeSpan refreshInterval;
    private CancellationTokenSource? periodicRefreshCancellation;
    private Task? periodicRefreshTask;
    private IJSObjectReference? visibilityModule;
    private DotNetObjectReference<FavoritesDashboard>? componentReference;
    private bool isDocumentActive;
    private bool isRefreshInProgress;
    private bool isDisposed;

    protected override async Task OnInitializedAsync()
    {
        var refreshIntervalSeconds = Configuration.GetValue<int>("FavoritesDashboard:RefreshIntervalSeconds");
        if (refreshIntervalSeconds <= 0)
            throw new InvalidOperationException("FavoritesDashboard:RefreshIntervalSeconds must be greater than zero.");
        refreshInterval = TimeSpan.FromSeconds(refreshIntervalSeconds);

        await LoadFavoritesAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || isDisposed)
            return;

        try
        {
            visibilityModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/favoritesDashboard.js");
            componentReference = DotNetObjectReference.Create(this);
            isDocumentActive = await visibilityModule.InvokeAsync<bool>("observeVisibility", componentReference);
            SynchronizePeriodicRefresh();
        }
        catch (JSException exception)
        {
            Logger.Error(nameof(FavoritesDashboard), "Failed to observe document visibility for automatic refresh.", exception);
            statusMessage = "A atualização automática não está disponível neste momento.";
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public Task SetDocumentVisibilityAsync(bool isActive)
        => InvokeAsync(() =>
        {
            if (isDisposed)
                return;

            isDocumentActive = isActive;
            SynchronizePeriodicRefresh();
        });

    private async Task RefreshAsync()
    {
        statusMessage = null;
        await RefreshEntriesAsync();
    }

    private async Task RetryLoadFavoritesAsync()
    {
        if (hasLoadedFavorites || isLoading || isDisposed)
            return;

        await LoadFavoritesAsync();
    }

    private async Task LoadFavoritesAsync()
    {
        isLoading = true;
        storageError = null;
        statusMessage = null;
        try
        {
            var loadedFavorites = await FavoriteStore.LoadAsync();
            favorites = loadedFavorites;
            hasLoadedFavorites = true;
            await RefreshEntriesAsync();
            SynchronizePeriodicRefresh();
        }
        catch (JSException exception)
        {
            Logger.Error(nameof(FavoritesDashboard), "Failed to access saved favorites in browser storage.", exception);
            storageError = "Não foi possível aceder aos favoritos guardados neste browser. Os dados existentes não foram alterados.";
        }
        catch (JsonException exception)
        {
            Logger.Error(nameof(FavoritesDashboard), "Saved favorites contain invalid JSON.", exception);
            storageError = "Os favoritos guardados têm um formato JSON inválido. Os dados existentes foram preservados.";
        }
        catch (InvalidDataException exception)
        {
            Logger.Error(nameof(FavoritesDashboard), "Saved favorites contain invalid or duplicate data.", exception);
            storageError = exception.Message.Contains("duplicate favorites", StringComparison.Ordinal)
                ? "Foram encontrados favoritos duplicados. Os dados existentes foram preservados e não foram carregados."
                : "Os favoritos guardados contêm dados inválidos. Os dados existentes foram preservados e não foram carregados.";
        }
        finally
        {
            isLoading = false;
            if (!isDisposed)
                await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RefreshEntriesAsync()
    {
        if (isDisposed || isRefreshInProgress)
            return;

        isRefreshInProgress = true;
        isLoading = true;
        try
        {
            var previousEntries = entries;
            entries = favorites
                .Select(favorite => previousEntries.FirstOrDefault(entry => entry.Favorite.HasSameIdentityAs(favorite))
                    ?? new FavoriteEntry(favorite))
                .ToList();
            await InvokeAsync(StateHasChanged);
            await Task.WhenAll(entries.Select(LoadFavoriteAsync));
        }
        finally
        {
            isRefreshInProgress = false;
            isLoading = false;
            if (!isDisposed)
                await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadFavoriteAsync(FavoriteEntry entry)
    {
        entry.State = FavoriteQueryState.Loading;
        try
        {
            if (entry.Favorite.Mode == FavoriteTransportMode.Bus)
            {
                if (string.IsNullOrWhiteSpace(entry.Favorite.DirectionId))
                {
                    entry.State = FavoriteQueryState.LegacyNeedsDirection;
                    return;
                }

                var provider = GetBusProvider(entry.Favorite.Provider);
                if (provider is null || string.IsNullOrWhiteSpace(entry.Favorite.LineNumber))
                    throw new InvalidDataException("The saved bus favorite context is invalid.");

                var resolved = await BusServiceRouter.ResolveLineAsync(provider.Value, entry.Favorite.LineNumber);
                if (isDisposed)
                    return;
                if (resolved.Line is null || resolved.Service is null)
                {
                    entry.State = FavoriteQueryState.Unavailable;
                    return;
                }

                var arrivals = await resolved.Service.GetArrivalsAsync(
                    entry.Favorite.StopId,
                    resolved.Line.Id,
                    entry.Favorite.DirectionId);
                if (isDisposed)
                    return;
                entry.BusArrivals = arrivals;
                SetSuccessfulState(entry, arrivals.Count > 0);
                return;
            }

            var trainOperator = entry.Favorite.Provider switch
            {
                FavoriteProvider.Cp => "CP",
                FavoriteProvider.Fertagus => "Fertagus",
                _ => null
            };
            var trainService = trainOperator is null
                ? null
                : TrainServices.FirstOrDefault(service =>
                    string.Equals(service.OperatorName, trainOperator, StringComparison.Ordinal));
            if (trainService is null)
            {
                entry.State = FavoriteQueryState.Unavailable;
                return;
            }

            if (entry.Favorite.DestinationId is null)
            {
                entry.State = FavoriteQueryState.LegacyNeedsDestination;
                return;
            }

            var destination = (await trainService.GetDestinationsAsync(entry.Favorite.StopId))
                .FirstOrDefault(candidate => string.Equals(
                    candidate.Id,
                    entry.Favorite.DestinationId,
                    StringComparison.Ordinal));
            if (isDisposed)
                return;
            if (destination is null)
            {
                entry.DestinationName = null;
                entry.State = FavoriteQueryState.DestinationUnavailable;
                return;
            }

            entry.DestinationName = GetTrainDestinationName(destination.Name);
            var departures = await trainService.GetDeparturesAsync(
                entry.Favorite.StopId,
                entry.Favorite.DestinationId);
            if (isDisposed)
                return;
            var sortedDepartures = departures
                .OrderBy(departure => GetMinutesUntil(departure.DisplayTime))
                .Take(5)
                .ToList();
            entry.TrainDepartures = sortedDepartures;
            SetSuccessfulState(entry, sortedDepartures.Count > 0);
        }
        catch (TransitSourceUnavailableException exception)
        {
            if (isDisposed)
                return;
            Logger.Warning(nameof(FavoritesDashboard), $"Source unavailable for favorite '{entry.Favorite.StopName}': {exception.Message}");
            entry.State = FavoriteQueryState.Unavailable;
        }
        catch (Exception exception)
        {
            if (isDisposed)
                return;
            Logger.Error(nameof(FavoritesDashboard), $"Failed to load favorite '{entry.Favorite.StopName}'.", exception);
            entry.State = FavoriteQueryState.Error;
        }
        finally
        {
            if (!isDisposed)
                await InvokeAsync(StateHasChanged);
        }
    }

    private void SynchronizePeriodicRefresh()
    {
        if (isDisposed || !isDocumentActive || favorites.Count == 0)
        {
            StopPeriodicRefresh();
            return;
        }

        if (periodicRefreshCancellation is not null)
            return;

        periodicRefreshCancellation = new CancellationTokenSource();
        periodicRefreshTask = RunPeriodicRefreshAsync(periodicRefreshCancellation);
    }

    private async Task RunPeriodicRefreshAsync(CancellationTokenSource cancellation)
    {
        try
        {
            while (true)
            {
                await Task.Delay(refreshInterval, TimeProvider, cancellation.Token);
                if (isDisposed || !isDocumentActive || favorites.Count == 0)
                    return;

                await InvokeAsync(() =>
                {
                    if (!isDisposed && isDocumentActive && favorites.Count > 0)
                        _ = RefreshAutomaticallyAsync();
                });
            }
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
        }
        finally
        {
            if (ReferenceEquals(periodicRefreshCancellation, cancellation))
            {
                periodicRefreshCancellation = null;
                periodicRefreshTask = null;
            }
            cancellation.Dispose();
        }
    }

    private async Task RefreshAutomaticallyAsync()
    {
        try
        {
            await RefreshEntriesAsync();
        }
        catch (Exception exception)
        {
            Logger.Error(nameof(FavoritesDashboard), "Automatic refresh failed.", exception);
        }
    }

    private void StopPeriodicRefresh()
    {
        var cancellation = periodicRefreshCancellation;
        periodicRefreshCancellation = null;
        cancellation?.Cancel();
    }

    private static void SetSuccessfulState(FavoriteEntry entry, bool hasDepartures)
    {
        entry.State = hasDepartures
            ? FavoriteQueryState.WithDepartures
            : FavoriteQueryState.NoDepartures;
        entry.LastSuccessfulState = entry.State;
    }

    private async Task RemoveAsync(TransitFavorite favorite)
    {
        var index = favorites.FindIndex(existing => existing.HasSameIdentityAs(favorite));
        if (index < 0 || index >= favorites.Count)
        {
            statusMessage = "A lista de favoritos mudou; atualize a página e tente novamente.";
            return;
        }

        var updated = favorites.ToList();
        updated.RemoveAt(index);
        await PersistFavoritesAsync(updated);
    }

    private async Task MoveAsync(TransitFavorite favorite, int offset)
    {
        var index = favorites.FindIndex(existing => existing.HasSameIdentityAs(favorite));
        var newIndex = index + offset;
        if (index < 0 || index >= favorites.Count || newIndex < 0 || newIndex >= favorites.Count)
        {
            statusMessage = "A lista de favoritos mudou; atualize a página e tente novamente.";
            return;
        }

        var updated = favorites.ToList();
        var movedFavorite = updated[index];
        updated.RemoveAt(index);
        updated.Insert(newIndex, movedFavorite);
        await PersistFavoritesAsync(updated);
    }

    private async Task PersistFavoritesAsync(List<TransitFavorite> updated)
    {
        storageError = null;
        try
        {
            await FavoriteStore.SaveAsync(updated);
            favorites = updated;
            await RefreshEntriesAsync();
            SynchronizePeriodicRefresh();
        }
        catch (JSException exception)
        {
            Logger.Error(nameof(FavoritesDashboard), "Failed to persist favorites in browser storage.", exception);
            storageError = "Não foi possível guardar a alteração dos favoritos neste browser. A lista apresentada mantém os dados anteriores.";
        }
        catch (ArgumentException exception)
        {
            Logger.Error(nameof(FavoritesDashboard), "Rejected an invalid favorite change.", exception);
            storageError = "A alteração dos favoritos é inválida ou contém duplicados. A lista apresentada mantém os dados anteriores.";
        }
    }

    private static BusProvider? GetBusProvider(FavoriteProvider provider)
        => provider switch
        {
            FavoriteProvider.Metropolitana => BusProvider.Metropolitana,
            FavoriteProvider.CarrisLisboa => BusProvider.CarrisLisboa,
            FavoriteProvider.Transitland => BusProvider.Transitland,
            _ => null
        };

    private static string GetFavoriteTitle(FavoriteEntry entry)
    {
        var favorite = entry.Favorite;
        if (favorite.Mode == FavoriteTransportMode.Bus)
            return $"{favorite.LineNumber} · {favorite.StopName}";

        var destination = favorite.DestinationId is null
            ? "destino por selecionar"
            : entry.DestinationName ?? "destino indisponível";
        return $"{favorite.StopName} · {destination}";
    }

    private static string GetFavoriteUrl(FavoriteEntry entry)
    {
        var favorite = entry.Favorite;
        if (favorite.Mode == FavoriteTransportMode.Bus)
        {
            var busUrl = $"/buses?provider={Uri.EscapeDataString(favorite.Provider.ToString())}" +
                   $"&line={Uri.EscapeDataString(favorite.LineNumber ?? string.Empty)}" +
                   $"&stop={Uri.EscapeDataString(favorite.StopId)}";
            return string.IsNullOrWhiteSpace(favorite.DirectionId)
                ? busUrl
                : $"{busUrl}&direction={Uri.EscapeDataString(favorite.DirectionId)}";
        }

        var trainUrl = $"/trains?provider={Uri.EscapeDataString(favorite.Provider.ToString())}" +
                       $"&station={Uri.EscapeDataString(favorite.StopId)}";
        return favorite.DestinationId is null
            ? trainUrl
            : $"{trainUrl}&destination={Uri.EscapeDataString(favorite.DestinationId)}";
    }

    private static string GetBusDestinationLabel(BusArrival arrival)
        => string.IsNullOrWhiteSpace(arrival.Destination) ? "Indisponível" : arrival.Destination;

    private static string GetTrainDestinationName(string directionName)
    {
        var destinationSeparator = directionName.LastIndexOf(" → ", StringComparison.Ordinal);
        return destinationSeparator >= 0
            ? directionName[(destinationSeparator + 3)..]
            : directionName;
    }

    private static string GetProviderName(FavoriteProvider provider)
        => provider switch
        {
            FavoriteProvider.Metropolitana => "Carris Metropolitana",
            FavoriteProvider.CarrisLisboa => "Carris Lisboa",
                FavoriteProvider.Transitland => "Fonte técnica: Transitland",
            FavoriteProvider.Cp => "CP",
            FavoriteProvider.Fertagus => "Fertagus",
            _ => provider.ToString()
        };

    private static string GetModeName(FavoriteTransportMode mode)
        => mode switch
        {
            FavoriteTransportMode.Bus => "Autocarros",
            FavoriteTransportMode.Train => "Comboios",
            _ => mode.ToString()
        };

    private static string GetRemainingLabel(string displayTime)
    {
        var minutes = GetMinutesUntil(displayTime);
        if (!double.IsFinite(minutes))
            return string.Empty;

        return minutes <= 1
            ? "em breve"
            : $"daqui a {Math.Ceiling(minutes)} min";
    }

    private static double GetMinutesUntil(string displayTime)
    {
        if (!displayTime.Contains(':') ||
            !TimeSpan.TryParse(displayTime, out var departureTime))
            return double.PositiveInfinity;

        var lisbonZone = TimeZoneInfo.FindSystemTimeZoneById("Europe/Lisbon");
        var now = TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, lisbonZone).TimeOfDay;
        var difference = departureTime - now;
        if (difference < TimeSpan.Zero)
        {
            if (difference > TimeSpan.FromMinutes(-1))
                difference = TimeSpan.Zero;
            else
                difference += TimeSpan.FromDays(1);
        }

        return difference.TotalMinutes;
    }

    private enum FavoriteQueryState
    {
        Loading,
        LegacyNeedsDirection,
        LegacyNeedsDestination,
        DestinationUnavailable,
        NoDepartures,
        WithDepartures,
        Unavailable,
        Error
    }

    private sealed class FavoriteEntry(TransitFavorite favorite)
    {
        public TransitFavorite Favorite { get; } = favorite;
        public FavoriteQueryState State { get; set; } = FavoriteQueryState.Loading;
        public FavoriteQueryState? LastSuccessfulState { get; set; }
        public string? DestinationName { get; set; }
        public List<BusArrival> BusArrivals { get; set; } = [];
        public List<TrainDeparture> TrainDepartures { get; set; } = [];
    }

    public async ValueTask DisposeAsync()
    {
        if (isDisposed)
            return;

        isDisposed = true;
        isDocumentActive = false;
        StopPeriodicRefresh();

        var refreshTask = periodicRefreshTask;
        if (refreshTask is not null)
            await refreshTask;
        periodicRefreshTask = null;

        if (visibilityModule is not null)
        {
            try
            {
                await visibilityModule.InvokeVoidAsync("stopObservingVisibility");
            }
            catch (JSDisconnectedException exception)
            {
                Logger.Warning(nameof(FavoritesDashboard), $"Could not remove the document visibility listener: {exception.Message}");
            }
            catch (JSException exception)
            {
                Logger.Error(nameof(FavoritesDashboard), "Failed to remove the document visibility listener.", exception);
            }
            finally
            {
                componentReference?.Dispose();
                try
                {
                    await visibilityModule.DisposeAsync();
                }
                catch (JSDisconnectedException exception)
                {
                    Logger.Warning(nameof(FavoritesDashboard), $"Could not release the document visibility module: {exception.Message}");
                }
                visibilityModule = null;
            }
        }
        else
        {
            componentReference?.Dispose();
        }
    }
}
