<div class="top-row navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">MyBusApp</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                <span class="transport-icon" aria-hidden="true">🏠</span> Favoritos
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/buses">
                <span class="transport-icon" aria-hidden="true">🚌</span> Autocarros
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/metro">
                <span class="transport-icon" aria-hidden="true">🚇</span> Metro
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/trains">
                <span class="transport-icon" aria-hidden="true">🚆</span> Comboios
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/boats">
                <span class="transport-icon" aria-hidden="true">⛴️</span> Barcos
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
